# Server-only configuration; never commit a populated .env file.
# Email stays disabled until the verified sender and anti-abuse keys are configured.
CONTACT_ENABLED=false
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CONTACT_ALLOWED_ORIGINS=https://www.wclcricket.com

# Canonical domain: https://www.wclcricket.com
# Opt in only after the canonical domain is serving this reviewed release.
# Preview deployments always remain noindex.
SEO_INDEXABLE=false
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
